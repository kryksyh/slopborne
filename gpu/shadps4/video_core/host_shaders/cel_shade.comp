// bbport: cel shading (also the Rotoscope preset): lighting in flat bands relative to the
// neighbourhood, hue kept or posterized, and outlines from depth discontinuities.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "retro_common.glsl"

void main() {
    if (!begin_pixel()) return;
    float bands = knobs[0], adapt = knobs[1], outline = knobs[3], sensitivity = knobs[4];
    bool smooth_surface = knobs[2] > 0.5;
    int width = int(knobs[5]);
    float saturation = knobs[6], colors = knobs[7];
    vec3 color = scene_color(scene_px);
    float l = max(luma(color), 1e-4);
    float t = local_tone(scene_px, adapt, smooth_surface);
    float band = min(floor(t * bands), bands - 1.0);
    float level = mix(0.07, 0.9, band / max(bands - 1.0, 1.0));
    vec3 hue = color / l;
    hue = max(mix(vec3(1.0), hue, saturation), 0.0);
    vec3 result = hue * level;
    if (colors >= 2.0) {
        result = floor(clamp(result, 0.0, 1.0) * (colors - 1.0) + 0.5) / (colors - 1.0);
    }
    if (outline > 0.0 && depth_edge(scene_px, sensitivity, width) > 0.5) {
        result = mix(result, result * 0.1, outline);
    }
    finish(result);
}

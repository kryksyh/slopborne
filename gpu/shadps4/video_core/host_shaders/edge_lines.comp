// bbport: the world as lines: depth silhouettes and creases only, as glowing Tron neon, a
// blueprint, chalk on a blackboard, or an ink sketch; a little of the scene can show through.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#include "retro_common.glsl"

void main() {
    if (!begin_pixel()) return;
    int style = int(knobs[0] + 0.5), width = int(knobs[1] + 0.5);
    float glow = knobs[2], scene_amount = knobs[3], sensitivity = knobs[4];
    float line = depth_edge(scene_px, sensitivity, width);
    // Glow: lines within a few scene pixels, fading with distance.
    float halo = 0.0;
    if (glow > 0.0) {
        for (int i = 0; i < 8; ++i) {
            float a = float(i) * 0.7854;
            for (int r = 2; r <= 4; r += 2) {
                ivec2 q = scene_px + ivec2(round(vec2(cos(a), sin(a)) * float(r)));
                halo += depth_edge(q, sensitivity, width) / float(r);
            }
        }
        halo = clamp(halo * 0.18, 0.0, 1.0) * glow;
    }
    vec3 shade = scene_color(scene_px) * scene_amount;
    vec3 background, ink;
    if (style == 1) { background = vec3(0.07, 0.24, 0.52); ink = vec3(0.92, 0.96, 1.0); }
    else if (style == 2) { background = vec3(0.12, 0.17, 0.14); ink = vec3(0.93, 0.93, 0.88); }
    else if (style == 3) { background = vec3(0.96, 0.95, 0.91); ink = vec3(0.08); }
    else { background = vec3(0.0, 0.01, 0.03); ink = vec3(0.2, 0.95, 1.0); }
    vec3 result = background + (style == 3 ? -shade * 0.5 : shade);
    if (style == 1) {
        // Blueprint grid every 16 output pixels.
        vec2 g = abs(fract(vec2(out_pixel) / 16.0) - 0.5);
        result += vec3(0.06) * float(min(g.x, g.y) > 0.46);
    }
    if (style == 2) result += (hash12(vec2(out_pixel)) - 0.5) * 0.04; // chalk dust
    result = mix(result, ink, clamp(halo, 0.0, 1.0) * (style == 3 ? 0.4 : 0.7));
    result = mix(result, ink, line);
    finish(result);
}

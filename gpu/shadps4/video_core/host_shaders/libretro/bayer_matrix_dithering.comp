#version 450
// bbport: compute port of the libretro shader dithering/shaders/bayer-matrix-dithering.glsl
// (https://github.com/libretro/glsl-shaders), unchanged except for the wrapper below.
// Original header:
// 8x8 Bayer matrix dithering
// by Martins Upitis
// license: "All the content here is and will be free to use for everyone, but a donation is always nice."
// url: http://devlog-martinsh.blogspot.com/2011/03/glsl-8x8-bayer-matrix-dithering.html
// adapted for RetroArch by hunterk

// Parameter lines go here:

#define PARAMETER_UNIFORM
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D Texture;
layout(binding = 1, rgba8) uniform writeonly image2D bbport_result;
layout(push_constant) uniform BbportParams {
    vec2 OutputSize;
    vec2 TextureSize;
    vec2 InputSize;
    int FrameCount;
    int FrameDirection;
    float bbport_param[24]; // the menu's knobs: the shader's #pragma parameters
    vec4 bbport_view_to_world[3];
    vec4 bbport_projection;
    vec4 bbport_flags; // z: the game stores this picture blue-first (read and write swapped)
};
vec4 bbport_texture(sampler2D s, vec2 uv) {
    vec4 c = texture(s, uv);
    return bbport_flags.z > 0.5 ? c.bgra : c;
}
vec4 bbport_texture(sampler2D s, vec2 uv, float bias) {
    vec4 c = texture(s, uv, bias);
    return bbport_flags.z > 0.5 ? c.bgra : c;
}
#define COMPAT_TEXTURE bbport_texture
#define texture2D bbport_texture
#define OrigInputSize InputSize
#define OrigTextureSize TextureSize
#define COMPAT_VARYING
#define COMPAT_PRECISION
#define COMPAT_ATTRIBUTE
vec4 TEX0;
vec4 TexCoord;
vec4 VertexCoord;
vec4 COLOR = vec4(1.0);
mat4 MVPMatrix = mat4(1.0);
vec4 bbport_position;
vec4 FragColor;
vec4 FragCoordC;
vec2 bbport_output_size() { return OutputSize; }
vec2 bbport_texture_size() { return TextureSize; }
vec2 bbport_input_size() { return InputSize; }

// 8x8 Bayer matrix dithering
// by Martins Upitis
// license: "All the content here is and will be free to use for everyone, but a donation is always nice."
// url: http://devlog-martinsh.blogspot.com/2011/03/glsl-8x8-bayer-matrix-dithering.html
// adapted for RetroArch by hunterk

// Parameter lines go here:
#pragma parameter animate "Dithering Animation" 0.0 0.0 1.0 1.0
#pragma parameter dither_size "Dither Size" 0.0 0.0 0.95 0.05



#if __VERSION__ >= 130



#else



#endif

#ifdef GL_ES

#else

#endif



vec4 COL0;







void vertex_main()
{
    bbport_position = MVPMatrix * VertexCoord;
    COL0 = COLOR;
    TEX0.xy = TexCoord.xy;
}



#if __VERSION__ >= 130



#else


#endif

#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH

#else

precision mediump int;
#endif

#else

#endif


// compatibility #defines
#define Source Texture
#define vTexCoord TEX0.xy

#define SourceSize vec4(TextureSize, 1.0 / TextureSize) //either TextureSize or InputSize
#define outsize vec4(OutputSize, 1.0 / OutputSize)

#ifdef PARAMETER_UNIFORM
// All parameter floats need to have COMPAT_PRECISION in front of them
#define animate (bbport_param[0])
#define dither_size (bbport_param[1])
#else
#define animate 0.0
#define dither_size 0.0
#endif

float find_closest(int x, int y, float c0)
{
int dither[8][8] = {
{ 0, 32, 8, 40, 2, 34, 10, 42}, /* 8x8 Bayer ordered dithering */
{48, 16, 56, 24, 50, 18, 58, 26}, /* pattern. Each input pixel */
{12, 44, 4, 36, 14, 46, 6, 38}, /* is scaled to the 0..63 range */
{60, 28, 52, 20, 62, 30, 54, 22}, /* before looking in this table */
{ 3, 35, 11, 43, 1, 33, 9, 41}, /* to determine the action. */
{51, 19, 59, 27, 49, 17, 57, 25},
{15, 47, 7, 39, 13, 45, 5, 37},
{63, 31, 55, 23, 61, 29, 53, 21} }; 

float limit = 0.0;
if(x < 8)
{
limit = (dither[x][y]+1)/64.0;
}

if(c0 < limit)
return 0.0;
return 1.0;
}

void shader_main()
{
float Scale = 3.0 + mod(2.0 * FrameCount, 32.0) * animate + dither_size;
vec4 lum = vec4(0.299, 0.587, 0.114, 0);
float grayscale = dot(COMPAT_TEXTURE(Source, vTexCoord), lum);
vec3 rgb = COMPAT_TEXTURE(Source, vTexCoord).rgb;

vec2 xy = (vTexCoord * outsize.xy) * Scale;
int x = int(mod(xy.x, 8));
int y = int(mod(xy.y, 8));

vec3 finalRGB;
finalRGB.r = find_closest(x, y, rgb.r);
finalRGB.g = find_closest(x, y, rgb.g);
finalRGB.b = find_closest(x, y, rgb.b);

float final = find_closest(x, y, grayscale);

   FragColor = vec4(finalRGB, 1.0);
} 

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(bbport_output_size())))) return;
    vec2 uv = (vec2(p) + 0.5) / bbport_output_size();
    TEX0 = vec4(uv * bbport_input_size() / bbport_texture_size(), 0.0, 0.0);
    TexCoord = TEX0;
    VertexCoord = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
    FragCoordC = vec4(vec2(p) + 0.5, 0.0, 1.0);
    FragColor = vec4(0.0);
    vertex_main();
    shader_main();
    vec3 bbport_color = clamp(FragColor.rgb, 0.0, 1.0);
    imageStore(bbport_result, p, vec4(bbport_flags.z > 0.5 ? bbport_color.bgr : bbport_color, 1.0));
}

// Parameter lines go here:
#pragma parameter BEVEL_LEVEL "Bevel Level" 0.2 0.0 0.5 0.01
#pragma parameter InputGamma "Input Gamma" 2.4 0.1 5.0 0.1
#pragma parameter OutputGamma "Output Gamma" 2.2 0.1 5.0 0.1



#if __VERSION__ >= 130



#else



#endif

#ifdef GL_ES

#else

#endif



vec4 COL0;

// out variables go here as COMPAT_VARYING whatever







// vertex compatibility #defines
#define vTexCoord TEX0.xy
#define SourceSize vec4(TextureSize, 1.0 / TextureSize) //either TextureSize or InputSize
#define outsize vec4(OutputSize, 1.0 / OutputSize)

void vertex_main()
{
    bbport_position = MVPMatrix * VertexCoord;
    COL0 = COLOR;
    TEX0.xy = TexCoord.xy * 1.0000001;
}



#if __VERSION__ >= 130



#else


#endif

#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH

#else

#endif

#else

#endif



// fragment compatibility #defines
#define Source Texture
#define vTexCoord TEX0.xy

#define SourceSize vec4(TextureSize, 1.0 / TextureSize) //either TextureSize or InputSize
#define outsize vec4(OutputSize, 1.0 / OutputSize)

#ifdef PARAMETER_UNIFORM
#define BEVEL_LEVEL (bbport_param[0])
#define InputGamma (bbport_param[1])
#define OutputGamma (bbport_param[2])
#else
#define BEVEL_LEVEL 0.2
#define InputGamma 2.4
#define OutputGamma 2.2
#endif

#define GAMMA_IN(color)     pow(color, vec3(InputGamma, InputGamma, InputGamma))
#define GAMMA_OUT(color)    pow(color, vec3(1.0 / OutputGamma, 1.0 / OutputGamma, 1.0 / OutputGamma))

vec3 bevel(vec2 pos, vec3 color)
{
    vec3 weight;

    float r = sqrt(dot(pos, vec2(1.0)));

    vec3 delta = mix(vec3(BEVEL_LEVEL), vec3(1.0-BEVEL_LEVEL), color);

    weight = delta*(1.-r);

    return color+weight;
}

void shader_main()
{
    vec2 position = fract(vTexCoord * SourceSize.xy);
    if (any(notEqual(InputSize, OrigInputSize)))
        position = fract(vTexCoord * TextureSize.xy / InputSize.xy * OrigInputSize.xy);

    vec3 color = GAMMA_IN(COMPAT_TEXTURE(Source, vTexCoord).rgb);

    color = clamp(bevel(position, color), 0.0, 1.0);

   FragColor = vec4(GAMMA_OUT(color), 1.0);
} 

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(bbport_output_size())))) return;
    vec2 uv = (vec2(p) + 0.5) / bbport_output_size();
    TEX0 = vec4(uv * bbport_input_size() / bbport_texture_size(), 0.0, 0.0);
    TexCoord = TEX0;
    VertexCoord = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
    FragCoordC = vec4(vec2(p) + 0.5, 0.0, 1.0);
    FragColor = vec4(0.0);
    vertex_main();
    shader_main();
    vec3 bbport_color = clamp(FragColor.rgb, 0.0, 1.0);
    imageStore(bbport_result, p, vec4(bbport_flags.z > 0.5 ? bbport_color.bgr : bbport_color, 1.0));
}
